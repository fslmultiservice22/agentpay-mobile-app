{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "env": {
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT": "disabled",
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT_PROFILE": "ordinary"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview2": {
      "env": {
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT": "disabled",
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT_PROFILE": "ordinary"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview3": {
      "env": {
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT": "disabled",
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT_PROFILE": "ordinary"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT": "disabled",
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT_PROFILE": "ordinary"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "prelaunch": {
      "node": "22.14.0",
      "environment": "preview",
      "distribution": "internal",
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT": "disabled",
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT_PROFILE": "ordinary"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    },
    "csv-pilot": {
      "extends": "prelaunch",
      "env": {
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT": "enabled",
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT_PROFILE": "csv-pilot-internal"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT": "disabled",
        "EXPO_PUBLIC_AGENTPAY_CSV_PILOT_PROFILE": "ordinary"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "~/.android/service-account-key.json",
        "track": "internal"
      }
    }
  }
}
